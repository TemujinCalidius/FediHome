# ============================================
# FediHome — Environment Configuration
# ============================================
# Copy this file to .env.local and fill in your values.
# Most settings are configured via the setup wizard at /setup
#
# Required values are uncommented. Optional ones are commented out.

# --- Database ---
DATABASE_URL=postgresql://user:password@localhost:5432/fedihome

# --- Site URL ---
# Your public domain (used for ActivityPub, RSS, links)
SITE_URL=http://localhost:3000

# Refuse to start in production if SITE_URL is missing or points somewhere the
# Fediverse can't reach (localhost, a private network). Your address is baked
# into your ActivityPub identity and into every post you publish, and it can't
# be corrected afterwards — so booting with the wrong one is unrecoverable while
# refusing to boot is a two-minute fix. Set to true only for local testing.
# FEDIHOME_ALLOW_LOCAL_IDENTITY=true

# --- Optional: App listen port ---
# Port the app binds to (npm start / pm2). Defaults to 3000. Set this if
# port 3000 is already taken on the host. NOTE: the listen port is separate
# from SITE_URL above — if you change it, make sure SITE_URL still points at
# your real public origin, or federation/CSRF will break.
# PORT=3000
# Docker only: host port published by docker-compose (maps to container :3000).
# FEDIHOME_PORT=3000

# --- Admin Secret ---
# Generated automatically during setup. This is NOT your password — it's the key
# that signs your login session and encrypts every credential you save (Bluesky,
# Threads, analytics, Web Push). Back it up: it is not in the database, so
# restoring a database onto a host with a different secret makes all of those
# permanently unreadable. It should never need to change.
ADMIN_SECRET=

# --- Optional: initial admin password ---
# Sets your admin password on FIRST BOOT, then is ignored — useful for scripted
# or hosted provisioning, where nobody is present to use the setup screen.
# Minimum 12 characters. Once set you can change it in the admin panel, and it's
# safe to remove this line. If you don't set it, you'll log in with ADMIN_SECRET
# once and be prompted to choose a real password.
# ADMIN_PASSWORD=

# --- Optional: Admin session lifetime ---
# How many days an admin login stays valid before it must sign in again
# (default 30). Sessions are individually revocable from the /admin/sessions
# page, so a lost/stolen device can be signed out without rotating ADMIN_SECRET.
# ADMIN_SESSION_TTL_DAYS=30

# --- Optional: App (OAuth) token lifetime ---
# How many days a bearer token issued to a connected app (via the OAuth flow)
# stays valid. Unset (or <= 0) → tokens don't expire (long-lived + revocable from
# /admin/apps), which is the default. Set a number to auto-expire app tokens;
# expired tokens are rejected and swept automatically.
# APP_TOKEN_TTL_DAYS=90

# --- Optional: First-run setup token ---
# Protects the one-time setup wizard on a fresh, publicly-exposed deploy: until
# ADMIN_SECRET is set, completing /setup requires this token, so a stranger
# can't claim your site first. If you don't set it here, FediHome generates one
# on first run and prints it to the server console. (install.sh sets
# ADMIN_SECRET for you, so its installs skip the wizard entirely.)
# SETUP_TOKEN=

# --- Fediverse Identity ---
# Your handle will be @FEDI_HANDLE@FEDI_DOMAIN
FEDI_HANDLE=me
FEDI_DOMAIN=example.com

# --- Site Info ---
# SITE_NAME=My FediHome
# AUTHOR_NAME=Your Name
# AUTHOR_TAGLINE=
# AUTHOR_BIO=
# CONTACT_EMAIL=
# SITE_DESCRIPTION=A personal space on the Fediverse.
# ACTOR_SUMMARY=A personal blog on the Fediverse, powered by FediHome.

# --- Optional: Public landing / showcase mode ---
# Turns the homepage into a project-style landing page (hero + feature
# highlights + CTAs) instead of the personal blog intro. Off by default.
# Used by the public demo to present an "About FediHome" homepage.
# LANDING_MODE=true
# LANDING_HEADLINE=Your own website — that people can actually follow.
# LANDING_SUBHEAD=Share short posts, full articles, photos, video and audio — all on a site that's truly yours. Anyone can follow you and see it in their feed, and you'll see the people you follow in yours.
# REPO_URL=https://github.com/TemujinCalidius/fedihome

# --- Optional: Public read-only Fediverse feed ---
# Exposes /fediverse — a login-free, read-only view of the accounts you follow
# (no like/boost/reply, no admin). Great for a demo. Off by default.
# PUBLIC_FEED=true
# PUBLIC_FEED_TITLE=The Fediverse feed

# --- Optional: Hide your social graph ---
# When set, /ap/followers and /ap/following still report their counts but no
# longer list who follows you / who you follow (Mastodon's "hide social graph").
# Off by default.
# HIDE_SOCIAL_GRAPH=true

# --- Optional: Navigation visibility ---
# Hide nav sections you don't use. Each section shows unless set to "false".
# NAV_SHOW_JOURNAL=false
# NAV_SHOW_ARTICLES=false
# NAV_SHOW_PHOTOGRAPHY=false
# NAV_SHOW_VIDEOS=false
# NAV_SHOW_AUDIO=false
# NAV_SHOW_ABOUT=false

# --- Optional: Footer extras ---
# The copyright (AUTHOR_NAME), Fediverse handle and CONTACT_EMAIL show
# automatically. These optional extras only appear when set:
# WEBRING_URL=https://your-webring.example
# WEBRING_LABEL=Webring
# FOOTER_BADGE_SRC=https://example.com/badge.png
# FOOTER_BADGE_HREF=https://example.com
# FOOTER_BADGE_ALT=Some badge
# Optional "Support the project" link — a themed ♥ link on the landing page
# (LANDING_MODE) and in the footer. Point it at your GitHub Sponsors / Ko-fi /
# Liberapay / etc. Unset → no donation link shown anywhere.
# FUNDING_URL=https://github.com/sponsors/yourname
# FUNDING_LABEL=Support FediHome

# --- Optional: macOS app download ---
# When enabled, a "Download" nav link, a homepage hero CTA, and a /download page
# appear — a marketing surface for the FediHome macOS app. Off by default (a
# personal instance isn't advertising an app it may not use). Used by the demo.
# Both URLs already default to the project's own app, so you only need to set
# these to point at a fork/rebuild: the release URL tracks the app repo's GitHub
# Releases "latest" (newest notarized build), and the App Store URL is the live
# listing (region-neutral, so Apple redirects each visitor to their storefront).
# DOWNLOAD_MACOS_ENABLED=true
# DOWNLOAD_MACOS_RELEASE_URL=https://github.com/TemujinCalidius/FediHome-macOS/releases/latest
# DOWNLOAD_MACOS_APP_STORE_URL=https://apps.apple.com/app/fedihome/id6790605091

# --- Optional: Web Push (PWA phone notifications) ---
# Lets you install the site to your phone's home screen and receive push
# notifications for likes/boosts/replies/follows/DMs/comments — even when closed.
# EASIEST: generate keys in Admin → Site settings → Phone notifications (one
# click, stored encrypted at rest — no keys in this file). These env vars are a
# fallback for automated deploys; a key generated in the admin panel wins.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com

# --- Optional: Bluesky Crossposting ---
# PREFERRED: connect Bluesky in the admin panel at /admin/integrations — no file
# editing or restart, and the app password is stored encrypted at rest. These
# env vars remain as an alternative / fallback (an admin-panel value wins).
# Get an app password at: https://bsky.app/settings/app-passwords
# Handle without a leading "@" (a pasted "@you.bsky.social" is stripped anyway).
# BLUESKY_HANDLE=yourhandle.bsky.social
# BLUESKY_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
# Running your own PDS instead of bsky.social? Point FediHome at it (#449). Your
# handle, posts and followers belong to your account rather than to Bluesky's
# server, so only the address changes. Must be a bare https:// origin — no path,
# no credentials — and it has to be reachable from the internet.
# THIS IS CURRENTLY THE ONLY WAY TO SET IT: there is no field for it in the admin
# panel yet (#504). Unset → https://bsky.social, and nothing changes.
# BLUESKY_SERVICE=https://pds.example.com

# --- Optional: Threads Crossposting ---
# Also configurable (encrypted) in the admin panel at /admin/integrations.
# THREADS_ACCESS_TOKEN=
# THREADS_USER_ID=

# --- Optional: Tinylytics Analytics ---
# Privacy-focused analytics. Create a site at https://tinylytics.app.
# TINYLYTICS_SITE_ID is the NUMERIC site id (from your dashboard). It drives the
# server-side API reads, and — with TINYLYTICS_API_KEY set — the on-page tracking
# embed's code (the site's `uid`) is derived from it automatically, so pageview
# collection just works. TINYLYTICS_API_KEY is also required for the in-app
# analytics dashboard, kudos and leaderboard. All settable in Admin → Site
# settings → Analytics too — the API key is stored encrypted at rest (a saved
# key/id takes precedence over these env vars).
# TINYLYTICS_API_KEY=tly-fa-xxxx
# TINYLYTICS_SITE_ID=
# Only needed WITHOUT an API key: the embed code is the site's `uid` (letters +
# hyphens, e.g. vGTbspkpj5RT-Qspi-3R), NOT the numeric site id — the numeric id
# 404s and silently collects nothing. Find it via GET /api/v1/sites/<id>.
# TINYLYTICS_EMBED_ID=

# --- Optional: Email (for account recovery + DayOne journal) ---
# Journal-by-email (DayOne). Optional — and now settable from
# Admin -> Site settings -> Integrations instead, where the password is stored
# encrypted at rest. A saved value wins over these; they stay as a fallback so
# existing installs keep working untouched.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=you@example.com
# SMTP_PASS=
# DAYONE_EMAIL=

# --- Optional: Reverse proxy (rate limiting) ---
# Where uploaded media is written. Optional — defaults to public/uploads inside
# the install. You can also set this from Admin -> Site settings -> Storage,
# which is the better route unless you're scripting a deploy; a value saved
# there wins over this one. Must be an absolute path that already exists and is
# writable by the app. Changing it does NOT move existing files: new uploads go
# to the new place, and older media keeps being served from the old one.
# In Docker, set this as well as pointing the bind mount at it, so the entrypoint
# can fix ownership before dropping to the unprivileged user.
# FEDIHOME_UPLOADS_DIR=/mnt/media/fedihome-uploads

# How to apply an update, for deployments FediHome can't work out on its own.
# It detects a git checkout, a container and a release archive, and tells you the
# right command for each. If your image is rolled by a platform or orchestrator
# (Kubernetes, Nomad, Swarm, Fly, Render, any PaaS) none of those fit — there's
# no host to run `docker compose` on — and no amount of probing can tell it what
# your pipeline is. Say so here instead.
#
# FEDIHOME_UPDATE_URL is the more useful of the two: the update alert in the
# notification bell is a LINK, so clicking it is the action. Point it at your
# deploy pipeline, runbook or control plane. Applies only to FediHome's own
# update alerts — dependency and security-advisory alerts keep pointing at npm
# and the advisory, because those links are the evidence, not the action.
# FEDIHOME_UPDATE_URL=https://ci.example.com/fedihome/deploy
# FEDIHOME_UPDATE_TEXT=To apply it, approve the pending deploy in Argo CD.

# Set to "true" when behind a trusted reverse proxy (Cloudflare, nginx, …) so the
# rate limiters key on the real client IP instead of one shared bucket. Leave
# unset if not behind a proxy — an instance reached directly must not believe any
# of these headers, because the client sets them.
# TRUSTED_PROXY=true
#
# Which header to believe. Only ONE is trusted, and only the one you name here:
# a forwarded header is unforgeable only if the proxy in front of this instance
# OVERWRITES it, and which one that is depends entirely on your setup.
#
#   x-real-ip         the nginx config in docs/deployment.md sets this from
#                     $remote_addr — an overwrite. This is the DEFAULT when
#                     TRUSTED_PROXY=true and you name nothing.
#   cf-connecting-ip  set by Cloudflare, and trustworthy ONLY behind Cloudflare.
#                     Anywhere else it is a header the client can simply send.
#   x-forwarded-for   the leftmost hop. Name this only if your proxy REPLACES
#                     the header. Cloudflare and the shipped nginx config both
#                     APPEND to it, which leaves hop 0 client-controlled.
#
# If you run Cloudflare in front of nginx, x-real-ip is Cloudflare's edge, not
# your visitor — you want cf-connecting-ip. An unrecognised value here trusts
# nothing, and a mismatch is logged once so it shows up in your support bundle.
# TRUSTED_PROXY_HEADER=x-real-ip

# --- Optional: Podcast feed (/audio) ---
# Overrides for the audio RSS/podcast feed; sensible defaults are derived from
# your site config when unset.
# PODCAST_TITLE=
# PODCAST_AUTHOR=
# PODCAST_DESCRIPTION=
# PODCAST_EMAIL=
# PODCAST_IMAGE=

# --- Optional: Debug logging ---
# Set to "true" for verbose ActivityPub-inbox + Micropub debug logging.
# FEDIHOME_DEBUG=true

# --- Optional: Scheduler (background jobs) ---
# The scheduler runs inside the app (started automatically with the server) and
# publishes scheduled posts and runs the Bluesky sync. Defaults are sensible;
# override the cadences (seconds) or disable a job if needed.
# NOTE: it also runs under `next dev` — if your dev database holds real
# scheduled posts you don't want federated, set SCHEDULER_PUBLISH_ENABLED=false.
# SCHEDULER_PUBLISH_ENABLED=true          # publish due scheduled posts
# SCHEDULER_PUBLISH_INTERVAL_SEC=60       # how often to check (default 60s)
# SCHEDULER_BLUESKY_ENABLED=true          # default: on when BLUESKY_HANDLE is set
# SCHEDULER_BLUESKY_INTERVAL_SEC=900      # Bluesky sync cadence (default 15 min)
# SCHEDULER_DELIVERY_ENABLED=true         # retry failed follower deliveries (#207)
# SCHEDULER_DELIVERY_INTERVAL_SEC=60      # retry-sweep cadence (default 60s)
# SCHEDULER_CROSSPOST_ENABLED=true        # retry failed Bluesky/Threads crossposts (#225)
# SCHEDULER_CROSSPOST_INTERVAL_SEC=60     # retry-sweep cadence (default 60s)
# SCHEDULER_STORAGE_ENABLED=true          # measure disk usage + trim the remote-media cache (#385)
# SCHEDULER_STORAGE_INTERVAL_SEC=3600     # scan cadence (default hourly)
# Look for new FediHome releases, package updates and security advisories, and
# report them in your notifications (#399). Makes outbound requests to the npm
# registry and the GitHub API; set to false if this instance shouldn't call out.
# Also configurable in Admin → Instance settings, with a "Check now" button.
# SCHEDULER_UPDATE_CHECK_ENABLED=true     # daily update + advisory check (#399)
# SCHEDULER_UPDATE_CHECK_INTERVAL_SEC=86400  # cadence (default daily; 24h is the ceiling)
# Explore feed (#386): fetch the posts your follows have replied to, so you can
# discover people through the ones you already chose. THE SWITCH IS IN
# Admin → Site settings → Explore, not here — this variable only lets you hold
# the job off at the process level regardless of that setting (a read-only
# volume, a migration window). Makes a small number of outbound requests to other
# servers each hour, capped at ten per run.
# SCHEDULER_EXPLORE_ENABLED=false         # force-off override; the site setting turns it on
# SCHEDULER_EXPLORE_INTERVAL_SEC=3600     # cadence (default hourly)
